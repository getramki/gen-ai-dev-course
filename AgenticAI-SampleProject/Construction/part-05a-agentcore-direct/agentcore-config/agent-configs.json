{
  "purchase_agent": {
    "name": "construction-purchase-agent",
    "description": "Construction company procurement agent with cost optimization",
    "container": {
      "image": "910673207244.dkr.ecr.us-east-1.amazonaws.com/construction-purchase-agent:latest",
      "port": 10001,
      "health_check_path": "/.well-known/agent-card.json"
    },
    "environment": {
      "AWS_DEFAULT_REGION": "us-east-1",
      "PYTHONPATH": "/app"
    },
    "resources": {
      "cpu": "1 vCPU",
      "memory": "2 GB",
      "storage": "10 GB"
    },
    "iam_role": "AgentCoreBedrockExecutionRole"
  },
