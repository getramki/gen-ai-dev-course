FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY part-03-a2a-communication/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy steel agent code
COPY part-03-a2a-communication/steel_agent/ ./

# Set environment variables
ENV PYTHONPATH=/app
ENV AWS_DEFAULT_REGION=us-east-1

# Expose port
EXPOSE 10003

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:10003/.well-known/agent-card.json || exit 1

# Run the agent
CMD ["python", "-m", "app", "--host", "0.0.0.0", "--port", "10003"]